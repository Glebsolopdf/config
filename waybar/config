{
    "layer": "top",
    "position": "top",
    "margin-top": 1,
    "margin-left": 1,
    "margin-right": 1,
    "spacing": 0, 

    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "group/system", "group/network-box", "group/hardware"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "󰮯",
            "default": "󰊠"
        }
    },
    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "󰏤 {artist} - {title}",
        "player-icons": {
            "default": "󰎆",
            "spotify": "󰓇"
        },
        "max-length": 60
    },
    "clock": {
        "interval": 60,
        "format": "󱑊 {:%H:%M  󰃭 %d.%m}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["hyprland/language", "pulseaudio"]
    },
    "hyprland/language": {
        "format": "󰌌 {short}",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰦨 {volume}%",
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "group/network-box": {
        "orientation": "horizontal",
        "modules": ["network#icon", "network#speed"]
    },
    "network#icon": {
        "interval": 2,
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰲜",
        "tooltip": false
    },
    "network#speed": {
        "interval": 2,
        "format-wifi": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        "format-ethernet": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
        "format-disconnected": "Offline",
        "min-length": 22,
        "max-length": 22,
        "align": 1,
        "tooltip": false
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": ["custom/gpu", "cpu", "temperature", "memory"]
    },
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{print \"󰢮 \"$1\"% 󰏈 \"$2\"°C\"}'",
        "interval": 2,
        "tooltip": false
    },
    "cpu": {
        "interval": 2,
        "format": "󰻠 {usage}%"
    },
    "temperature": {
        "interval": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input", 
        "critical-threshold": 75,
        "format": "󰏈 {temperatureC}°C"
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {used:0.1f}G/{total:0.0f}G"
    }
}